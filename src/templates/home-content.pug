-
  function toISODate(date) {
    return (new Date(Date.parse(date))).toLocaleString('en-US', { month: '2-digit', day: '2-digit', year: '2-digit' });
  }

main.content
  section.home--about-section
      span.section-label Intro
      p Tyler Reckart is a #[a(href="/about") creative technologist] focused on bringing emerging trading capabilities to market at #[a(href="https://altruist.com/", target="_blank", rel="noopener,noreferrer") Altruist].
  section.web
    span.section-label On The Web
    div.links
      a(href="https://github.com/tylerreckart") Github
      a(href="https://dribbble.com/rkrt") Dribbble
      a(href="https://bsky.app/profile/rkrt.net") Bluesky
  section.posts
    span.section-label Writing
    each post in posts
      div.list--item
        time(datetime!=toISODate(post.attributes.date), pubdate="pubdate")=toISODate(post.attributes.date)
        a(href="/posts/" + post.path) #[h2=post.attributes.title]
